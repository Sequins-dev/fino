  "packetCases": [
    {
            "id": "unsupported-version-initial",
            "source": "RFC 9000 section 6 Version Negotiation; Node/quiche/ngtcp2-style unsupported Initial probes",
            "matrixRow": "Version Negotiation",
      "packet": {
        "firstByte": "0xc0",
        "version": "0x57414954",
        "dcidLength": 8,
        "scidLength": 8,
        "tokenLength": 0,
        "payloadLength": 1200
      },
      "expected": {
        "outcome": "version-negotiation",
        "responseVersion": "0x00000000",
        "advertisesSupportedVersion": true
      }
    },
    {
            "id": "unvalidated-v1-initial",
            "source": "RFC 9000 section 8.1.2 Retry for address validation",
            "matrixRow": "Retry address validation",
      "packet": {
        "firstByte": "0xc0",
        "version": "0x00000001",
        "dcidLength": 8,
        "scidLength": 8,
        "tokenLength": 0,
        "payloadLength": 1200
      },
      "expected": {
        "outcome": "retry",
        "responseVersion": "0x00000001",
        "tokenRequired": true
      }
    },
    {
            "id": "malformed-initial-no-accept",
            "source": "RFC 9000 sections 7.2 and 14.1 malformed Initial handling",
            "matrixRow": "Initial packet size and padding",
      "packet": {
        "firstByte": "0xc0",
        "version": "0x00000001",
        "dcidLength": 21,
        "scidLength": 8,
        "tokenLength": 0,
        "payloadLength": 1200
      },
      "expected": {
        "outcome": "drop",
        "createsAcceptState": false,
        "amplifies": false
      }
    }
  ],
